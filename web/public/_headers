/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://bvnnpqubzkxiizhinyuy.supabase.co wss://bvnnpqubzkxiizhinyuy.supabase.co; frame-ancestors 'none'; form-action 'self'; base-uri 'self'
